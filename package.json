{
  "name": "taskflow",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS görev yönetimi uygulaması",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:archive-worker": "npm run dev:archive-worker --workspace=backend",
    "docker:up": "docker compose up -d --wait postgres redis",
    "docker:down": "docker compose down",
    "build:frontend": "npm run build --workspace=frontend",
    "perf:bundle": "npm run build:frontend && node scripts/check-bundle-budget.mjs",
    "perf:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "perf:api": "npm run perf:api --workspace=backend",
    "check:critical-coverage": "node scripts/check-critical-coverage.mjs",
    "provider:preflight": "node scripts/provider-preflight.mjs github-release",
    "e2e": "npm run build:frontend && playwright test",
    "perf:lighthouse:local": "node scripts/run-lighthouse-gate.mjs",
    "backup:rehearsal": "node scripts/run-backup-rehearsal.mjs",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run docker:up && concurrently --kill-others-on-fail --names \"backend,archive-worker,frontend\" --prefix-colors \"green,yellow,cyan\" \"npm run dev --workspace=backend\" \"npm run dev:archive-worker --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "down": "npm run docker:down",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "test": "npm run test --workspaces --if-present",
    "ci:check": "npm run lint && npm run build:frontend && npm run build:backend && npm test",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^10.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
