# Server
NODE_ENV=development
PORT=3001

# Database — Supabase Postgres
# Pooler (runtime):  postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres
# Direct (migrate):  postgresql://postgres.[ref]:[pass]@aws-0-[region].supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=
# Runtime pool idle retention: default 60 seconds; set to 10000 to restore 10 seconds.
RUNTIME_POOL_IDLE_TIMEOUT_MS=60000
# Archive worker: development falls back to DATABASE_URL; production requires this explicitly.
MAINTENANCE_DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Faz 2'de kullanılacak)
JWT_ACCESS_SECRET=replace-me-with-random-string-min-16-chars
JWT_REFRESH_SECRET=replace-me-with-random-string-min-16-chars

# CORS
CLIENT_URL=http://localhost:5173

# Canonical public API origin used for signed internal deliveries and local storage URLs
PUBLIC_API_ORIGIN=http://localhost:3001
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Storage provider (default keeps the existing Supabase behavior)
STORAGE_PROVIDER=supabase
# For local mode, set an absolute writable root and a dedicated random secret (32+ bytes).
# Selecting local does not transfer existing Supabase objects or database references.
LOCAL_STORAGE_ROOT=
LOCAL_STORAGE_SIGNING_SECRET=
# Required only when STORAGE_PROVIDER=supabase in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TASK_FILES_BUCKET=taskflow-task-files

# Backend observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
