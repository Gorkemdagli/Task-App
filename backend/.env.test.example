# Test environment — TEMPLATE for fresh clones.
#
# Usage:
#   cp backend/.env.test.example backend/.env.test
#
# Why a template, not committed directly?
# Keeps the .gitignore rule "no .env files in repo" consistent — even dummy
# test fixtures can drift (real prod creds accidentally pasted, JWT secrets
# copied from .env). The copy step forces the user to consciously own the file.
#
# Values below are local Docker defaults (postgres:taskflow@localhost:5433).
# They match docker-compose.yml and backend/docker/postgres-test-init.sql —
# nothing here is a real secret.
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://postgres:taskflow@localhost:5433/taskflow_test
DIRECT_URL=postgresql://postgres:taskflow@localhost:5433/taskflow_test
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=test-access-secret-min-16-chars
JWT_REFRESH_SECRET=test-refresh-secret-min-16-chars
CLIENT_URL=http://localhost:5173
