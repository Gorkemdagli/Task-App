{
  "name": "@taskflow/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:archive-worker": "tsx watch src/archive-worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:archive-worker": "node dist/archive-worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --allow-no-models",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3",
    "pino": "^8.19.0",
    "pino-http": "^9.0.0",
    "rate-limit-redis": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.1",
    "typescript": "^6.0.3",
    "vitest": "^1.3.0"
  }
}
