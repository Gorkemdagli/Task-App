[Unit]
Description=Check TaskFlow Master and deploy through local Coolify API
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
StateDirectory=taskflow-coolify-deploy
StateDirectoryMode=0700
LoadCredential=deploy-token:/etc/taskflow-coolify-deploy.token
ExecStart=/usr/local/sbin/taskflow-coolify-master-poller
TimeoutStartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/taskflow-coolify-deploy.uuid
